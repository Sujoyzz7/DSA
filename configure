#!/bin/sh
# Autogenerated simple ./configure for the DSA repository
# Usage: ./configure [--prefix=PREFIX] [--enable-debug] [--with-cxx=COMPILER]

set -eu

default_prefix="/usr/local"
PREFIX="$default_prefix"
DEBUG=0
CXX=""

for arg in "$@"; do
  case "$arg" in
    --prefix=*) PREFIX="${arg#--prefix=}" ;;
    --enable-debug) DEBUG=1 ;;
    --with-cxx=*) CXX="${arg#--with-cxx=}" ;;
    --help|-h) 
      cat <<'EOF'
Usage: ./configure [OPTIONS]

Options:
  --prefix=DIR       Installation prefix (default: /usr/local)
  --enable-debug     Build with debugging flags (-g -O0)
  --with-cxx=COMP    Specify the C++ compiler (g++, clang++, ...)
  -h, --help         Show this help message

This configure script generates a simple Makefile that will compile all
C++ sources (*.cpp, *.cc, *.cxx) in the repository into executables placed
in the top-level bin/ directory. Subdirectory separators are converted to
double-underscores in the output filenames to avoid creating many nested
directories.
EOF
      exit 0
      ;;
    *) echo "Unknown option: $arg"; exit 2 ;;
  esac
done

if [ -z "$CXX" ]; then
  for try in g++ clang++ c++; do
    if command -v "$try" >/dev/null 2>&1; then
      CXX="$try"
      break
    fi
  done
fi

if [ -z "$CXX" ]; then
  echo "Error: no C++ compiler found (tried g++, clang++, c++)." >&2
  echo "Set --with-cxx=COMP or install a compiler." >&2
  exit 1
fi

# Default flags
if [ "$DEBUG" -eq 1 ]; then
  CXXFLAGS="-g -O0 -std=c++17 -Wall -Wextra"
else
  CXXFLAGS="-O2 -std=c++17 -Wall -Wextra"
fi

cat > Makefile <<EOF
# Auto-generated Makefile by ./configure
CXX := $CXX
CXXFLAGS := $CXXFLAGS
PREFIX := $PREFIX

SRCS := $(shell find . -type f \( -name '*.cpp' -o -name '*.cc' -o -name '*.cxx' \) -not -path './.git/*' -not -path './bin/*')

.PHONY: all clean install
all:
	@echo "Building executables for $$((`echo \"$$SRCS\" | wc -l`)) source files..." || true
	@rm -rf bin
	@mkdir -p bin
	@for src in $$SRCS; do \
		# convert ./path/to/file.cpp -> bin/path__to__file (without extension)
		file=$$(echo "$$src" | sed 's/^\.\///'); \
		out=bin/$$(echo "$$file" | sed -E 's/\.(cpp|cc|cxx)$$//' | sed 's|/|__|g'); \
		echo "Compiling $$src -> $$out"; \
		$${CXX} $${CXXFLAGS} -o "$$out" "$$src" || exit 1; \
	done
	@echo "Done. Binaries are in ./bin"

clean:
	rm -rf bin Makefile

install: all
	@echo "Installing to $(PREFIX)/bin"
	@mkdir -p "$(PREFIX)/bin"
	@cp -r bin/* "$(PREFIX)/bin/"

EOF

chmod +x Makefile 2>/dev/null || true

echo "Generated Makefile. Run 'make' to build, 'make install' to install to $PREFIX."